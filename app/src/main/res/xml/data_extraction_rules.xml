<?xml version="1.0" encoding="utf-8"?>
<!-- See https://developer.android.com/about/versions/12/backup-restore#xml-changes -->
<data-extraction-rules>
    <!-- Chat keys are encrypted with a key that never leaves this device's Android Keystore,
         so a copied key could never be decrypted on another device. -->
    <cloud-backup>
        <exclude domain="file" path="pgp/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="pgp/" />
    </device-transfer>
</data-extraction-rules>
